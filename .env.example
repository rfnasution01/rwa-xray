# CoinMarketCap Pro API — server-side only
CMC_API_KEY=
CMC_API_BASE_URL=https://pro-api.coinmarketcap.com

# Supabase PostgreSQL pooler connection string — server-side only
# Use a migration-capable Session Pooler from trusted release tooling.
DATABASE_URL=

# Public application origin — visible in the browser by design
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI provider. Gemini is the initial adapter.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Optional observability and cookieless analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
